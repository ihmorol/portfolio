# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=IHMOROL - Portfolio
NEXT_PUBLIC_SITE_DESCRIPTION=Computer Science Student | AI Engineer | Software Developer

# Recipient for contact form submissions and newsletter signups
CONTACT_EMAIL=ihmorol@gmail.com

# Email transport — Resend is recommended (works on serverless hosts like Vercel).
# Option 1: Resend (used when RESEND_API_KEY is set)
# CONTACT_FROM is optional; only needed after verifying your own domain with Resend.
RESEND_API_KEY=your_resend_api_key
# CONTACT_FROM=Portfolio <you@yourdomain.com>

# Option 2: SMTP via nodemailer (used when RESEND_API_KEY is not set)
# For Gmail, SMTP_PASSWORD must be a 16-character App Password, not your login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ihmorol@gmail.com
SMTP_PASSWORD=your_app_password

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
